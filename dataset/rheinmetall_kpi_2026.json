  "fuentes_y_metodologia": [
    {
      "capa": "1. Datos Corporativos Reales (Auditados / Públicos)",
      "alcance": "Sector 1 (Ventas: KPI 1.1 Book-to-Bill, KPI 1.2 Margen Operativo) y Anclajes Macro de Inventario y ESG (Q1-Q3 2026).",
      "fuente_oficial": "Rheinmetall AG — Annual Report FY 2025 (Düsseldorf, marzo 2026) y Quarterly Statements Q1, Q2 y Q3 2026 (9M 2026 Financial Release).",
      "valores_reales_verificables": "Ventas FY25: €9.935M | Margen Operativo FY25: 18,5% | Backlog fin 2025: €63.800M | Ventas 9M 2026: €8.376M | Rheinmetall Nomination (Pedidos) 9M 2026: €19.100M (Book-to-Bill real 9M = 2,28x) | Margen Operativo 9M 2026: 16,0% (resultado operativo reportado €1.339M; el motor usa €1.340,16M = 16,0% × ventas 9M) | Backlog Q3 2026: €78.000M | Inmovilización adicional de inventarios 2026: ~€2.000M | Dotación: >31.000 empleados.",
      "donde_inicia_sintetico": "Desagregación trimestral y mensual calibrada (Ene–Sep 2026): los trimestres Q1–Q3 no replican los Quarterly Statements individuales, pero su suma reproduce exactamente el acumulado 9M auditado (ventas €8.376M, pedidos €19.100M, margen 16,0%). El cierre Q4 2026 (Oct–Dic) es una proyección propia conservadora (FY €12.800M; margen 18,1%), por debajo del guidance ajustado por Rheinmetall el 05/11/2026 (~€13.200M; margen ~18,5%)."
    },
    {
      "capa": "2. Datos Híbridos Calibrados (Anclaje Público + Telemetría Operativa)",
      "alcance": "KPI 3.2 (Rechazo/Demora en Aceptación de Lotes), KPI 4.1 (Días de Inventario DOS) y KPI 5.2 (LTIFR Seguridad Laboral).",
      "fuente_oficial": "Rheinmetall AG Q3 2026 Earnings Call & Interim Report (divulgación sobre demoras de aceptación balística en lotes de 155 mm y acumulación estratégica de inventarios) + Non-Financial / ESG Report (tasa base de accidentabilidad ISO 45001).",
      "valores_reales_verificables": "Incremento de inventario de materias primas críticas (nitrocelulosa, algodón linters, aceros balísticos) cercano a €2.000M; retención temporal de lotes terminados de 155 mm en Q2-Q3 2026 por cuellos de botella en pruebas de aceptación estatal (GQAR); expansión de plantilla a 3 turnos.",
      "donde_inicia_sintetico": "Conteo exacto de lotes presentados vs. retenidos por mes (140–220 lotes/mes), consumo mensual de materiales en SAP MM (€625M–€820M/mes) y horas-hombre mensuales por planta (4,60M–5,30M h/mes) generados mediante simulación determinística calibrada."
    },
    {
      "capa": "3. Datos Industriales Simulados Calibrados (Piso de Planta MES / QMS / SCM)",
      "alcance": "KPI 2.1 (OEE), KPI 2.2 (Cumplimiento MPS), KPI 3.1 (First-Pass Yield), KPI 4.2 (Supplier OTIF) y KPI 5.1 (Cierre Proactivo de Riesgos EHS).",
      "fuente_oficial": "Benchmarks de Manufactura Aeroespacial y de Defensa Europea (Norma OTAN AQAP-2110, estándares VDMA/SEMI de automatización) aplicados al ramp-up real de Rheinmetall (escalamiento de 70.000 a >700.000 proyectiles de 155 mm/año en Unterlüß y Murcia).",
      "valores_reales_verificables": "Rheinmetall no divulga públicamente telemetría de máquinas PLC/SCADA, tiempos de ciclo, porcentajes de retrabajo interno ni cumplimiento individual por proveedor por motivos de seguridad nacional y secreto industrial.",
      "donde_inicia_sintetico": "100% de las variables granulares de planta (Tiempo Planificado, Tiempo Operativo Real, Ciclo Ideal 1,80 min/unidad, Piezas Inspeccionadas, Órdenes de Compra OTIF y Hallazgos ATEX/EHS) se simulan con curvas realistas de aprendizaje industrial: tensión operativa en Q1–Q2 (arranque de líneas y nuevos operarios) seguida de estabilización y cumplimiento de metas SMART en Q3–Q4 2026."
    }
  ],
  "catalogo_kpis": [
    {
      "codigo": "KPI-1.1",
      "sector": "1. Ventas",
      "nombre": "Ratio Book-to-Bill",
      "tipo": "Leading (Predictivo)",
      "unidad": "Ratio (x)",
      "meta": ">= 1,50x",
      "verde": ">= 1,50x",
      "amarillo": "1,10x - 1,49x",
      "rojo": "< 1,10x",
      "formula": "Nuevos Pedidos Captados [€] / Ventas Facturadas [€]",
      "herramienta": "SAP S/4HANA (SD) / CRM",
      "responsable": "VP Ventas Defensa",
      "protocolo": "Si < 1,50x: auditar licitaciones OTAN pendientes y revisar plazos; si > 2,00x sostenido: aprobar ampliación de CapEx."
    },
    {
      "codigo": "KPI-1.2",
      "sector": "1. Ventas",
      "nombre": "Margen de Resultado Operativo",
      "tipo": "Lagging (Resultado)",
      "unidad": "%",
      "meta": ">= 18,0%",
      "verde": ">= 18,0%",
      "amarillo": "15,5% - 17,9%",
      "rojo": "< 15,5%",
      "formula": "(Resultado Operativo EBIT [€] / Ventas Totales [€]) * 100",
      "herramienta": "SAP S/4HANA (FI/CO)",
      "responsable": "CFO / Controlling",
      "protocolo": "Si < 18,0%: desagregar por división, activar cláusulas de indexación inflacionaria y contener OPEX no crítico."
    },
    {
      "codigo": "KPI-2.1",
      "sector": "2. Línea de Producción",
      "nombre": "OEE (Eficiencia Global de Equipos)",
      "tipo": "Leading (Predictivo)",
      "unidad": "%",
      "meta": ">= 82,0%",
      "verde": ">= 82,0%",
      "amarillo": "75,0% - 81,9%",
      "rojo": "< 75,0%",
      "formula": "(Disponibilidad * Rendimiento * Calidad) * 100",
      "herramienta": "Siemens Opcenter MES / SCADA",
      "responsable": "Director de Planta",
      "protocolo": "Descomponer factor: mantenimiento preventivo/SMED si cae Disponibilidad; ajuste CNC si cae Rendimiento; calibración si cae Calidad."
    },
    {
      "codigo": "KPI-2.2",
      "sector": "2. Línea de Producción",
      "nombre": "Cumplimiento del Programa Maestro (MPS)",
      "tipo": "Lagging (Resultado)",
      "unidad": "%",
      "meta": ">= 95,0%",
      "verde": ">= 95,0%",
      "amarillo": "88,0% - 94,9%",
      "rojo": "< 88,0%",
      "formula": "(Unidades Producidas Liberadas / Unidades Planificadas MPS) * 100",
      "herramienta": "SAP S/4HANA (PP) + MES",
      "responsable": "Gerente Planificación",
      "protocolo": "Si < 95,0%: habilitar turnos extraordinarios de fin de semana, balancear carga entre Unterlüß/Murcia y repriorizar hitos."
    },
    {
      "codigo": "KPI-3.1",
      "sector": "3. Calidad",
      "nombre": "First-Pass Yield (FPY)",
      "tipo": "Leading (Predictivo)",
      "unidad": "%",
      "meta": ">= 97,0%",
      "verde": ">= 97,0%",
      "amarillo": "94,0% - 96,9%",
      "rojo": "< 94,0%",
      "formula": "((Unidades Inspeccionadas - Rechazadas/Retrabajadas) / Inspeccionadas) * 100",
      "herramienta": "QMS AQAP-2110 / END / SPC",
      "responsable": "Ingeniero Jefe QC",
      "protocolo": "Si < 97,0%: análisis causa raíz (Ishikawa / 5 Porqués), recalibrar sensores de visión/ultrasonido y reforzar capacitación."
    },
    {
      "codigo": "KPI-3.2",
      "sector": "3. Calidad",
      "nombre": "Tasa de Rechazo/Demora Aceptación Lotes",
      "tipo": "Lagging (Resultado)",
      "unidad": "%",
      "meta": "<= 1,5%",
      "verde": "<= 1,5%",
      "amarillo": "1,6% - 3,0%",
      "rojo": "> 3,0%",
      "formula": "(Lotes Rechazados o Retenidos / Total Lotes Presentados GQAR) * 100",
      "herramienta": "SAP QM / Actas GQAR / Polígonos",
      "responsable": "Gerente QA",
      "protocolo": "Si > 1,5%: exigir pre-certificación interna previa a inspección GQAR, ampliar turnos de polígono balístico y mesas técnicas."
    },
    {
      "codigo": "KPI-4.1",
      "sector": "4. Compras y Abast.",
      "nombre": "Días de Inventario de Suministros (DOS)",
      "tipo": "Leading (Predictivo)",
      "unidad": "Días",
      "meta": "65 - 80 días",
      "verde": "65 - 80 d",
      "amarillo": "50-64 d o 81-95 d",
      "rojo": "< 50 d o > 95 d",
      "formula": "(Valor Promedio Inventario [€] / Costo Materiales Consumidos [€]) * Días",
      "herramienta": "SAP S/4HANA (MM) + EWM",
      "responsable": "Director Supply Chain",
      "protocolo": "Si < 65 d: compras urgentes de nitrocelulosa/acero; si > 80 d: reprogramar entregas MRP no críticas y acelerar conversión WIP."
    },
    {
      "codigo": "KPI-4.2",
      "sector": "4. Compras y Abast.",
      "nombre": "Supplier OTIF (Entregas a Tiempo y Completas)",
      "tipo": "Lagging (Resultado)",
      "unidad": "%",
      "meta": ">= 94,0%",
      "verde": ">= 94,0%",
      "amarillo": "87,0% - 93,9%",
      "rojo": "< 87,0%",
      "formula": "(Órdenes Recibidas On-Time In-Full / Total Órdenes Programadas) * 100",
      "herramienta": "SAP S/4HANA (MM) / SAP Ariba",
      "responsable": "VP Compras Estratégicas",
      "protocolo": "Si < 94,0%: ejecutar penalidades contractuales, reasignar volumen a proveedores homologados (Dual Sourcing) y auditoría SQE."
    },
    {
      "codigo": "KPI-5.1",
      "sector": "5. Seguridad (EHS)",
      "nombre": "Tasa de Cierre Proactivo de Riesgos",
      "tipo": "Leading (Predictivo)",
      "unidad": "%",
      "meta": ">= 95,0%",
      "verde": ">= 95,0%",
      "amarillo": "85,0% - 94,9%",
      "rojo": "< 85,0%",
      "formula": "(Hallazgos y Cuasi-Accidentes Cerrados en SLA / Total Reportados) * 100",
      "herramienta": "SAP EHS Management",
      "responsable": "Gerente Corporativo EHS",
      "protocolo": "Si < 95,0%: escalar hallazgos vencidos al Director de Planta, asignar cuadrillas de mantenimiento y bloquear celdas de riesgo."
    },
    {
      "codigo": "KPI-5.2",
      "sector": "5. Seguridad (EHS)",
      "nombre": "LTIFR (Frecuencia Accidentes con Baja)",
      "tipo": "Lagging (Resultado)",
      "unidad": "Acc. / 10^6 h",
      "meta": "<= 2,20",
      "verde": "<= 2,20",
      "amarillo": "2,21 - 3,20",
      "rojo": "> 3,20",
      "formula": "(Accidentes con Baja * 1.000.000) / Horas-Hombre Trabajadas",
      "herramienta": "SAP EHS + SuccessFactors",
      "responsable": "Gerente EHS / Dir. Planta",
      "protocolo": "Si > 2,20: ejecutar Safety Stand-Down inmediato, investigación comité mixto y re-entrenamiento obligatorio LOTO/ATEX."
    }
  ],
